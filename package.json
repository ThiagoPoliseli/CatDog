{
  "name": "catdog-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "npm run test --workspace=apps/web",
    "test:coverage": "npm run test:coverage --workspace=apps/web",
    "test:e2e": "npm run test:e2e --workspace=apps/web",
    "makuco:init": "npx -y https://package.makuco.com.br/makuco/latest.tgz init"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
