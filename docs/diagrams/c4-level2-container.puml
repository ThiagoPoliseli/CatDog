@startuml
!define RELATIVE_INCLUDE .
!include lib/C4_Container.puml

title CatDog - C4 Container (Nível 2)

Person(adopter, "Adotante", "Pessoa interessada em adotar um animal")
Person(admin, "Administrador", "Equipe da organização que gerencia a plataforma")

System_Boundary(catdog, "CatDog") {
  Container(webapp, "Next.js Web App", "React / TypeScript", "Catálogo público, filtros, modal de solicitação, autenticação (entrar/cadastro/redefinir-senha), área do usuário e área administrativa")
  Container(server, "Next.js Server", "Node.js", "Server Components, Server Actions, API Routes: /api/adoption-requests, /api/auth/sign-up, /auth/callback. Middleware de proteção de rotas via Supabase Auth.")
}

ContainerDb_Ext(supabase_db, "Supabase PostgreSQL", "PostgreSQL", "Tabelas: species, sizes, breeds, animals, adoption_requests. RLS habilitado. Triggers para validação de status.")
System_Ext(supabase_auth, "Supabase Auth", "JWT + Cookies SSR", "Gerencia sessões de usuários e administradores")

Rel(adopter, webapp, "Navega catálogo, solicita adoção e acompanha solicitações", "HTTPS")
Rel(admin, webapp, "Gerencia animais, espécies, raças, portes e solicitações", "HTTPS + Supabase Auth")
Rel(webapp, server, "Requisições RSC / Server Actions / fetch")
Rel(server, supabase_db, "Persiste e consulta dados", "supabase-js SDK")
Rel(server, supabase_auth, "Autentica usuários e verifica sessões", "supabase-js SDK")

@enduml
